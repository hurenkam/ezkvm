-name
e2e-scsi-bridge
-machine
type=q35,hpet=off
-cpu
host
-m
4096M
-smp
cpus=4
-device
virtio-scsi-pci,id=scsihw0
-drive
file=local-lvm:vm-200-disk-0,if=none,id=drive-scsi0,format=qcow2,discard=unmap,cache=none,aio=io_uring,detect-zeroes=unmap
-device
scsi-hd,drive=drive-scsi0,id=scsi0,bus=scsihw0.0,scsi-id=0,rotation_rate=1,bootindex=100
-netdev
type=tap,id=net0,ifname=tap200i0,script=/usr/libexec/qemu-server/pve-bridge,downscript=/usr/libexec/qemu-server/pve-bridgedown,vhost=on,queues=4
-device
virtio-net,netdev=net0,mac=52:54:00:12:34:56,bus=pci.0,addr=0x12,rx_queue_size=1024,tx_queue_size=256
-device
qxl,vram_size_mb=64
-boot
menu=on,strict=on,reboot-timeout=1000,splash=/usr/share/qemu-server/bootsplash.jpg
-drive
if=pflash,unit=0,format=raw,readonly=on,file=/usr/share/ovmf/OVMF.fd
-chardev
socket,id=tpmchar,server=on,wait=off,path=/var/run/qemu-server/200.swtpm
-tpmdev
emulator,id=tpmdev,chardev=tpmchar
-device
tpm-tis,tpmdev=tpmdev
-device
virtio-balloon-pci
-pidfile
/var/run/qemu-server/200.pid
-nodefaults
-global
kvm-pit.lost_tick_policy=discard
-enable-kvm