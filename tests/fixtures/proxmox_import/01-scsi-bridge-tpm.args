-name
e2e-scsi-bridge
-machine
type=q35
-cpu
host
-m
4096M
-smp
cpus=4
-device
virtio-scsi-pci,id=scsihw0
-drive
file=local-lvm:vm-200-disk-0,if=none,id=drive-scsi0,format=qcow2,discard=unmap,cache=none
-device
scsi-hd,drive=drive-scsi0,id=scsi0,bus=scsihw0.0,bootindex=100
-netdev
type=bridge,id=net0,br=vmbr0,queues=4
-device
virtio-net,netdev=net0,mac=52:54:00:12:34:56
-device
qxl,vram_size_mb=64
-drive
if=pflash,unit=0,format=raw,readonly=on,file=/usr/share/ovmf/OVMF.fd
-chardev
socket,id=tpmchar,server=on,wait=off,path=/var/run/qemu-server/200.swtpm
-tpmdev
emulator,id=tpmdev,chardev=tpmchar
-device
tpm-tis,tpmdev=tpmdev
-device
virtio-balloon-pci
-pidfile
<RUNTIME_DIR>/ezkvm/e2e-scsi-bridge.pid
-nodefaults
-enable-kvm