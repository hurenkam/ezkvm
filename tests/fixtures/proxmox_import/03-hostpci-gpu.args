-name
e2e-hostpci-gpu
-machine
type=pc-q35-8.1+pve0
-cpu
host
-m
8192M
-smp
cpus=8
-readconfig
/usr/share/qemu-server/pve-q35-4.0.cfg
-netdev
type=bridge,id=net0,br=vmbr1
-device
virtio-net,netdev=net0,mac=52:54:00:de:ad:01
-device
virtio-balloon-pci
-device
vfio-pci,host=0000:03:00.0,id=hostpci0,bus=ich9-pcie-port-1,addr=0x0.0,multifunction=on
-device
vfio-pci,host=0000:03:00.1,id=hostpci1,bus=ich9-pcie-port-1,addr=0x0.1
-device
qemu-xhci,id=xhci,p2=15,p3=15
-pidfile
<RUNTIME_DIR>/ezkvm/e2e-hostpci-gpu.pid
-nodefaults
-vga
none
-nographic
-enable-kvm