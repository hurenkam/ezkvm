-name
e2e-hostpci-gpu
-machine
type=pc-q35-8.1+pve0
-cpu
host
-m
8192M
-smp
8,sockets=1,cores=8,maxcpus=8
-readconfig
/usr/share/qemu-server/pve-q35-4.0.cfg
-netdev
type=tap,id=net0,script=/usr/libexec/qemu-server/pve-bridge,downscript=/usr/libexec/qemu-server/pve-bridgedown,vhost=on
-device
virtio-net,netdev=net0,mac=52:54:00:de:ad:01,bus=pci.0,addr=0x12,rx_queue_size=1024,tx_queue_size=256
-boot
menu=on,strict=on,reboot-timeout=1000,splash=/usr/share/qemu-server/bootsplash.jpg
-device
vfio-pci,host=0000:03:00.0,id=hostpci0,bus=ich9-pcie-port-1,addr=0x0.0,multifunction=on
-device
vfio-pci,host=0000:03:00.1,id=hostpci1,bus=ich9-pcie-port-1,addr=0x0.1
-device
qemu-xhci,id=xhci,p2=15,p3=15,bus=pci.1,addr=0x1b
-qmp
unix:<RUNTIME_DIR>/ezkvm/e2e-hostpci-gpu.qmp,server=on,wait=off
-pidfile
<RUNTIME_DIR>/ezkvm/e2e-hostpci-gpu.pid
-no-shutdown
-nodefaults
-vga
none
-nographic
-global
kvm-pit.lost_tick_policy=discard
-enable-kvm
