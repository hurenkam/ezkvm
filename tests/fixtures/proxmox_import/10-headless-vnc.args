-name
fixture-headless-vnc
-machine
type=q35
-cpu
host
-m
4096M
-smp
cpus=4
-device
virtio-scsi-pci,id=scsihw0
-device
ahci,id=sata0
-drive
file=/var/lib/vm/scsi0.raw,if=none,id=drive-scsi0,format=raw,discard=unmap
-device
scsi-hd,drive=drive-scsi0,id=scsi0,bus=scsihw0.0
-drive
file=/var/lib/vm/sata0.raw,if=none,id=drive-sata0,format=raw,discard=unmap
-device
ide-hd,drive=drive-sata0,id=sata0,bus=sata0.0,unit=0
-netdev
type=bridge,id=net0,br=vmbr0
-device
virtio-net,netdev=net0,mac=52:54:00:12:34:56
-drive
if=pflash,unit=0,format=raw,readonly=on,file=/usr/share/ovmf/OVMF.fd
-device
virtio-serial-pci,id=virtio-serial0
-chardev
socket,path=/var/run/qemu-server/qga.sock,server=on,wait=off,id=qga0
-device
virtserialport,chardev=qga0,name=org.qemu.guest_agent.0
-device
virtio-balloon-pci
-vnc
unix:/var/run/qemu-server/405.vnc,password=on
-pidfile
<RUNTIME_DIR>/ezkvm/fixture-headless-vnc.pid
-nodefaults
-vga
none
-nographic
-enable-kvm