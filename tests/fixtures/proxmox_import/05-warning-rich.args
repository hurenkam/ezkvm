-name
e2e-warning
-machine
type=q35
-cpu
host
-m
3072M
-smp
cpus=2
-device
virtio-scsi-pci,id=scsihw0
-drive
file=/dev/zvol/rpool/data/vm-500-disk-0,if=none,id=drive-scsi0,format=raw,discard=unmap
-device
scsi-hd,drive=drive-scsi0,id=scsi0,bus=scsihw0.0
-netdev
type=bridge,id=net0,br=vmbr9
-device
virtio-net,netdev=net0,mac=52:54:00:fe:ed:01
-device
virtio-gpu,vram=33554432
-device
virtio-balloon-pci
-device
qemu-xhci,id=xhci
-device
usb-host,hostbus=3,hostport=1.4,id=usb0,bus=xhci.0,port=1
-pidfile
<RUNTIME_DIR>/ezkvm/e2e-warning.pid
-nodefaults
-enable-kvm