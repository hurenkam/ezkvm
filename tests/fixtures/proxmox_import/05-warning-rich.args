-name
e2e-warning
-machine
type=q35
-cpu
host
-m
3072M
-smp
cpus=2
-device
virtio-scsi-pci,id=scsihw0
-drive
file=/dev/zvol/rpool/data/vm-500-disk-0,if=none,id=drive-scsi0,format=raw,discard=unmap,cache=none,aio=io_uring,detect-zeroes=unmap
-device
scsi-hd,drive=drive-scsi0,id=scsi0,bus=scsihw0.0,scsi-id=0
-netdev
type=tap,id=net0,ifname=tap500i0,script=/usr/libexec/qemu-server/pve-bridge,downscript=/usr/libexec/qemu-server/pve-bridgedown,vhost=on
-device
virtio-net,netdev=net0,mac=52:54:00:fe:ed:01,bus=pci.0,addr=0x12,rx_queue_size=1024,tx_queue_size=256
-device
virtio-gpu,vram=33554432
-boot
menu=on,strict=on,reboot-timeout=1000,splash=/usr/share/qemu-server/bootsplash.jpg
-device
virtio-balloon-pci
-device
qemu-xhci,id=xhci
-device
usb-host,hostbus=3,hostport=1.4,id=usb0,bus=xhci.0,port=1
-qmp
unix:<RUNTIME_DIR>/ezkvm/e2e-warning.qmp,server=on,wait=off
-pidfile
/var/run/qemu-server/500.pid
-nodefaults
-global
kvm-pit.lost_tick_policy=discard
-enable-kvm