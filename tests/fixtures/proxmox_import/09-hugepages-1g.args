-name
e2e-hugepages-1g
-machine
type=q35
-cpu
host
-m
8192M
-smp
4,sockets=1,cores=4,maxcpus=4
-device
virtio-scsi-pci,id=scsihw0
-drive
file=local-lvm:vm-300-disk-0,if=none,id=drive-scsi0,format=qcow2,discard=unmap,cache=none,aio=io_uring,detect-zeroes=unmap
-device
scsi-hd,drive=drive-scsi0,id=scsi0,bus=scsihw0.0,scsi-id=0
-netdev
type=user,id=net0
-device
e1000,netdev=net0,mac=52:54:00:aa:bb:ee
-device
cirrus
-boot
menu=on,strict=on,reboot-timeout=1000,splash=/usr/share/qemu-server/bootsplash.jpg
-device
virtio-balloon-pci
-object
memory-backend-file,id=ram-node0,size=8192M,mem-path=/run/hugepages/kvm/1048576kB,share=on,prealloc=yes
-numa
node,nodeid=0,memdev=ram-node0
-numa
cpu,node-id=0,socket-id=0
-numa
cpu,node-id=0,socket-id=1
-numa
cpu,node-id=0,socket-id=2
-numa
cpu,node-id=0,socket-id=3
-qmp
unix:<RUNTIME_DIR>/ezkvm/e2e-hugepages-1g.qmp,server=on,wait=off
-pidfile
/var/run/qemu-server/300.pid
-nodefaults
-global
kvm-pit.lost_tick_policy=discard
-enable-kvm