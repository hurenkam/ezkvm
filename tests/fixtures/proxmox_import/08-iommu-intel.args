-name
e2e-iommu-intel
-machine
type=pc-q35-8.1,viommu=intel
-cpu
host
-m
1024M
-smp
cpus=1
-netdev
type=user,id=net0
-device
e1000,netdev=net0,mac=52:54:00:aa:bb:cd
-device
cirrus
-boot
menu=on,strict=on,reboot-timeout=1000,splash=/usr/share/qemu-server/bootsplash.jpg
-device
virtio-balloon-pci
-device
intel-iommu,id=iommu0,intremap=on
-qmp
unix:<RUNTIME_DIR>/ezkvm/e2e-iommu-intel.qmp,server=on,wait=off
-pidfile
<RUNTIME_DIR>/ezkvm/e2e-iommu-intel.pid
-nodefaults
-global
kvm-pit.lost_tick_policy=discard
-global
ICH9-LPC.disable_s3=1
-global
ICH9-LPC.disable_s4=1
-enable-kvm