-name
e2e-iommu-intel
-machine
type=pc-q35-8.1,viommu=intel
-cpu
host
-m
1024M
-smp
cpus=1
-netdev
type=user,id=net0
-device
e1000,netdev=net0,mac=52:54:00:aa:bb:cd
-device
cirrus
-device
virtio-balloon-pci
-device
intel-iommu,id=iommu0,intremap=on
-pidfile
<RUNTIME_DIR>/ezkvm/e2e-iommu-intel.pid
-nodefaults
-enable-kvm