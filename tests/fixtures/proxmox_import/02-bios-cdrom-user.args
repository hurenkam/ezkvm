-name
e2e-bios-cdrom
-machine
type=q35
-cpu
host
-m
2048M
-smp
cpus=2
-drive
if=none,id=drive-ide2,media=cdrom,readonly=on
-device
ide-cd,drive=drive-ide2,id=ide2,bootindex=101
-netdev
type=user,id=net0
-device
e1000,netdev=net0,mac=52:54:00:aa:bb:cc
-device
cirrus
-pidfile
<RUNTIME_DIR>/ezkvm/e2e-bios-cdrom.pid
-enable-kvm