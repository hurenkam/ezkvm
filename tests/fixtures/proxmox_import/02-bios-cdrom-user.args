-name
e2e-bios-cdrom
-machine
type=q35
-cpu
host
-m
2048M
-smp
2,sockets=1,cores=2,maxcpus=2
-drive
if=none,id=drive-ide2,media=cdrom,readonly=on
-device
ide-cd,drive=drive-ide2,id=ide2,bus=ide.1,unit=0,bootindex=101
-netdev
type=user,id=net0
-device
e1000,netdev=net0,mac=52:54:00:aa:bb:cc
-device
cirrus
-boot
menu=on,strict=on,reboot-timeout=1000,splash=/usr/share/qemu-server/bootsplash.jpg
-chardev
socket,id=qmp,path=<RUNTIME_DIR>/ezkvm/e2e-bios-cdrom.qmp,server=on,wait=off
-mon
chardev=qmp,mode=control
-chardev
socket,id=qmp-event,path=<RUNTIME_DIR>/ezkvm/e2e-bios-cdrom-event.sock,server=on,wait=off
-mon
chardev=qmp-event,mode=control
-pidfile
<RUNTIME_DIR>/ezkvm/e2e-bios-cdrom.pid
-no-shutdown
-nodefaults
-global
kvm-pit.lost_tick_policy=discard
-enable-kvm
