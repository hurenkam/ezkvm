-name
e2e-usb
-machine
type=q35
-cpu
host
-m
2048M
-smp
2,sockets=1,cores=2,maxcpus=2
-boot
menu=on,strict=on,reboot-timeout=1000,splash=/usr/share/qemu-server/bootsplash.jpg
-device
qemu-xhci,id=xhci
-device
usb-host,hostbus=1,hostport=2.2,id=usb0,bus=xhci.0,port=1
-device
usb-host,host=0451:16a0,id=usb1,bus=xhci.0,port=2
-chardev
socket,id=qmp,path=<RUNTIME_DIR>/ezkvm/e2e-usb.qmp,server=on,wait=off
-mon
chardev=qmp,mode=control
-chardev
socket,id=qmp-event,path=<RUNTIME_DIR>/ezkvm/e2e-usb-event.sock,server=on,wait=off
-mon
chardev=qmp-event,mode=control
-pidfile
<RUNTIME_DIR>/ezkvm/e2e-usb.pid
-no-shutdown
-nodefaults
-global
kvm-pit.lost_tick_policy=discard
-enable-kvm
