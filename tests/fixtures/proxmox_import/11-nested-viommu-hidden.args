-name
fixture-nested
-machine
type=q35,hpet=off,viommu=intel
-cpu
host,kvm=off,-hypervisor,hidden=1
-m
8192M
-smp
cpus=8
-device
virtio-scsi-pci,id=scsihw0
-drive
file=/var/lib/vm/nested.raw,if=none,id=drive-scsi0,format=raw,discard=unmap,cache=none,aio=io_uring,detect-zeroes=unmap
-device
scsi-hd,drive=drive-scsi0,id=scsi0,bus=scsihw0.0,scsi-id=0
-netdev
type=tap,id=net0,script=/usr/libexec/qemu-server/pve-bridge,downscript=/usr/libexec/qemu-server/pve-bridgedown,vhost=on
-device
virtio-net,netdev=net0,mac=52:54:00:65:43:21,bus=pci.0,addr=0x12,rx_queue_size=1024,tx_queue_size=256
-device
virtio-gpu
-boot
menu=on,strict=on,reboot-timeout=1000,splash=/usr/share/qemu-server/bootsplash.jpg
-drive
if=pflash,unit=0,format=raw,readonly=on,file=/usr/share/ovmf/OVMF.fd
-device
virtio-serial,id=qga0,bus=pci.0,addr=0x8
-chardev
socket,path=/var/run/qemu-server/qga.sock,server=on,wait=off,id=qga0
-device
virtserialport,chardev=qga0,name=org.qemu.guest_agent.0
-device
virtio-balloon-pci
-device
intel-iommu,id=iommu0,intremap=on
-pidfile
<RUNTIME_DIR>/ezkvm/fixture-nested.pid
-nodefaults
-global
kvm-pit.lost_tick_policy=discard
-enable-kvm