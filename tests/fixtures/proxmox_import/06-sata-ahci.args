-name
e2e-sata-ahci
-machine
type=q35
-cpu
host
-m
2048M
-smp
2,sockets=1,cores=2,maxcpus=2
-device
ahci,id=sata0
-drive
file=/var/lib/vm/sata0.raw,if=none,id=drive-sata0,format=raw,discard=unmap
-device
ide-hd,drive=drive-sata0,id=sata0,bus=sata0.0,unit=0,bootindex=100
-drive
if=none,id=drive-sata1,media=cdrom,readonly=on
-device
ide-cd,drive=drive-sata1,id=sata1,bus=sata0.1,unit=0,bootindex=101
-netdev
type=user,id=net0
-device
e1000,netdev=net0,mac=52:54:00:aa:bb:cc
-device
cirrus
-boot
menu=on,strict=on,reboot-timeout=1000,splash=/usr/share/qemu-server/bootsplash.jpg
-chardev
socket,id=qmp,path=<RUNTIME_DIR>/ezkvm/e2e-sata-ahci.qmp,server=on,wait=off
-mon
chardev=qmp,mode=control
-chardev
socket,id=qmp-event,path=<RUNTIME_DIR>/ezkvm/e2e-sata-ahci-event.sock,server=on,wait=off
-mon
chardev=qmp-event,mode=control
-pidfile
<RUNTIME_DIR>/ezkvm/e2e-sata-ahci.pid
-no-shutdown
-nodefaults
-global
kvm-pit.lost_tick_policy=discard
-enable-kvm
