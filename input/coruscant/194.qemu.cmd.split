  -machine 'pflash0=pflash0,pflash1=drive-efidisk0,type=pc-q35-10.0+pve1,kernel-irqchip=split' \
  -cpu 'EPYC-Rome-v4,-hypervisor,kvm=off,+svm,hv_ipi,hv_relaxed,hv_reset,hv_runtime,hv_spinlocks=0x1fff,hv_stimer,hv_synic,hv_time,hv_vapic,hv_vendor_id=proxmox,hv_vpindex,kvm=off,+kvm_pv_eoi,+kvm_pv_unhalt,-clwb,-umip,-rdpid,-wbnoinvd,-ibrs,-amd-stibp,-amd-ssbd'
