/usr/bin/kvm \
  -id 401 \
  -name 'monterey,debug-threads=on' \
  -no-shutdown \
  -chardev 'socket,id=qmp,path=/var/run/qemu-server/401.qmp,server=on,wait=off' \
  -mon 'chardev=qmp,mode=control' \
  -chardev 'socket,id=qmp-event,path=/var/run/qmeventd.sock,reconnect-ms=5000' \
  -mon 'chardev=qmp-event,mode=control' \
  -pidfile /var/run/qemu-server/401.pid \
  -daemonize \
  -smbios 'type=1,uuid=05cba597-8096-47c6-9cd7-1481dbb3b95a' \
  -drive 'if=pflash,unit=0,format=raw,readonly=on,file=/usr/share/pve-edk2-firmware//OVMF_CODE.fd' \
  -drive 'if=pflash,unit=1,id=drive-efidisk0,format=raw,file=/dev/vm1/vm-401-disk-1,size=131072' \
  -smp '8,sockets=1,cores=8,maxcpus=8' \
  -nodefaults \
  -boot 'menu=on,strict=on,reboot-timeout=1000,splash=/usr/share/qemu-server/bootsplash.jpg' \
  -vga none \
  -nographic \
  -cpu 'Penryn,enforce,+kvm_pv_eoi,+kvm_pv_unhalt,vendor=GenuineIntel' \
  -m 16384 \
  -object 'memory-backend-file,id=ram-node0,size=16384M,mem-path=/run/hugepages/kvm/1048576kB,share=on,prealloc=yes' \
  -numa 'node,nodeid=0,cpus=0-7,memdev=ram-node0' \
  -readconfig /usr/share/qemu-server/pve-q35-4.0.cfg \
  -device 'vmgenid,guid=524269fb-c10d-40f9-a908-edde75e93d1e' \
  -device 'usb-tablet,id=tablet,bus=ehci.0,port=1' \
  -device 'vfio-pci,host=0000:07:00.0,id=hostpci0,bus=ich9-pcie-port-1,addr=0x0' \
  -device 'vfio-pci,host=0000:41:00.0,id=hostpci1.0,bus=ich9-pcie-port-2,addr=0x0.0,multifunction=on,romfile=/usr/share/kvm/vgabios-radeon-rx570.bin' \
  -device 'vfio-pci,host=0000:41:00.1,id=hostpci1.1,bus=ich9-pcie-port-2,addr=0x0.1' \
  -device 'vfio-pci,host=0000:0e:10.2,id=hostpci2,bus=ich9-pcie-port-3,addr=0x0,rombar=0' \
  -chardev 'socket,path=/var/run/qemu-server/401.qga,server=on,wait=off,id=qga0' \
  -device 'virtio-serial,id=qga0,bus=pci.0,addr=0x8' \
  -device 'virtserialport,chardev=qga0,name=org.qemu.guest_agent.0' \
  -device 'virtio-balloon-pci,id=balloon0,bus=pci.0,addr=0x3' \
  -iscsi 'initiator-name=iqn.1993-08.org.debian:01:89402da79cc0' \
  -drive 'file=/dev/vm1/vm-401-disk-0,if=none,id=drive-virtio0,cache=writeback,discard=on,format=raw,aio=io_uring,detect-zeroes=unmap' \
  -device 'virtio-blk-pci,drive=drive-virtio0,id=virtio0,bus=pci.0,addr=0xa,bootindex=100' \
  -drive 'file=/dev/ws0/vm-401-disk-0,if=none,id=drive-virtio1,cache=unsafe,discard=on,format=raw,aio=io_uring,detect-zeroes=unmap' \
  -device 'virtio-blk-pci,drive=drive-virtio1,id=virtio1,bus=pci.0,addr=0xb' \
  -netdev 'type=tap,id=net0,ifname=tap401i0,script=/usr/libexec/qemu-server/pve-bridge,downscript=/usr/libexec/qemu-server/pve-bridgedown,vhost=on' \
  -device 'virtio-net-pci,mac=16:AF:B7:83:E6:31,netdev=net0,bus=pci.0,addr=0x12,id=net0' \
  -machine 'type=pc-q35-5.2+pve0' \
  -device 'isa-applesmc,osk=<OSK>' \
  -smbios 'type=2' \
  -device 'usb-kbd,bus=ehci.0,port=2' \
  -cpu 'host,enforce,hv_ipi,hv_relaxed,hv_reset,hv_runtime,hv_spinlocks=0x1fff,hv_stimer,hv_synic,hv_time,hv_vapic,hv_vendor_id=proxmox,hv_vpindex,kvm=off,+kvm_pv_eoi,+kvm_pv_unhalt,+lahf_lm,+sep,+svm,+npt,+nrip_save,+fxsr_opt,+hypervisor,vendor=GenuineIntel'
