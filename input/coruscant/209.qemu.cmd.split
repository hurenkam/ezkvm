  -vnc 'unix:/var/run/qemu-server/209.vnc,password=on' \
  -cpu qemu64,+aes,enforce,+kvm_pv_eoi,+kvm_pv_unhalt,+pni,+popcnt,+sse4.1,+sse4.2,+ssse3 \
  -m 65536 \
