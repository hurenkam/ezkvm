  -device 'vfio-pci,host=0000:44:00.0,id=hostpci1.0,bus=ich9-pcie-port-2,addr=0x0.0,multifunction=on' \
  -device 'vfio-pci,host=0000:44:00.1,id=hostpci1.1,bus=ich9-pcie-port-2,addr=0x0.1' \
  -device 'vfio-pci,host=0000:0e:10.2,id=hostpci2,bus=ich9-pcie-port-3,addr=0x0' \
  -device 'ich9-intel-hda,id=audiodev0,bus=pci.2,addr=0xc' \
